# Django Server Configuration
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=True

# ==============================================================================
# COMPANY DATA PROVIDER CONFIGURATION
# ==============================================================================
# Supported providers:
# - auto: Queries live provider if credentials set, seamlessly falls back to verified MCA registry
# - mca_api / surepass / karza / sandbox: Connects to specified commercial MCA gateway
# - registry: Built-in verified offline MCA registry with authentic master records
COMPANY_DATA_PROVIDER=auto

# Authorized External Provider Credentials (leave blank to use verified offline registry)
COMPANY_DATA_API_KEY=
COMPANY_DATA_API_URL=https://kyc-api.surepass.io/api/v1/corporate/mca-company-details
COMPANY_DATA_PROVIDER_HEADER=Authorization
